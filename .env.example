# Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# MongoDB Connection String
# Local: mongodb://localhost:27017/portfolio
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/portfolio
MONGODB_URI=mongodb://localhost:27017/portfolio

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-key-here
NEXTAUTH_SECRET=your-nextauth-secret-key-here (legacy/fallback)

# Your application URL
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (optional - for GitHub login)
# Create app at: https://github.com/settings/developers
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret

# =============================================================================
# EMAIL (for NextAuth email provider)
# =============================================================================
# SMTP Configuration (e.g., Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourportfolio.com

# Alternative: Resend (simpler email service)
# RESEND_API_KEY=re_your_api_key_here

# =============================================================================
# FILE UPLOADS (Cloudinary)
# =============================================================================
# Option 1: Single URL (recommended)
# Get from: https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option 2: Separate credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# WEBHOOKS (n8n or other automation)
# =============================================================================
# Secret for validating webhook requests
WEBHOOK_SECRET=your-webhook-secret-for-validation

# Your n8n webhook URL
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact

# =============================================================================
# RATE LIMITING (optional - defaults provided)
# =============================================================================
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=5

# Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

